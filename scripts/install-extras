#!/usr/bin/env bash
# The splash and the offers both installers run: scripts/install from a
# checkout, and install.sh from the files a release tarball ships beside loopherd.
#
#   install-extras splash
#   install-extras offers <agents> <skills> <herdr-plugin> <herdr-keys> <loopherd> [<settings file>]
#
# Each offer is ask, yes or no; ask reads its answer from stdin.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

play_splash() {
  local splash_file="$root/scripts/install-splash.bash"
  [[ -r "$splash_file" ]] || return 0
  # shellcheck source=install-splash.bash
  source "$splash_file"
  splash_wants_to_play || return 0
  splash_play
}

run_offers() {
  local agents=$1 skills=$2 herdr_plugin=$3 herdr_keys=$4 loopherd=$5 settings=${6:-}
  # shellcheck source=install-agents.bash
  source "$root/scripts/install-agents.bash"
  # shellcheck source=install-skills.bash
  source "$root/scripts/install-skills.bash"
  # shellcheck source=install-herdr-plugin.bash
  source "$root/scripts/install-herdr-plugin.bash"
  # shellcheck source=install-herdr-keys.bash
  source "$root/scripts/install-herdr-keys.bash"

  local claude_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  if [[ -n "$settings" ]]; then
    claude_dir=$(dirname "$settings")
    # Absolute, so CLAUDE_CONFIG_DIR and what the installer prints don't hang on cwd.
    if [[ -d "$claude_dir" ]]; then
      claude_dir=$(cd "$claude_dir" && pwd)
    elif [[ "$claude_dir" != /* ]]; then
      claude_dir="$PWD/${claude_dir#./}"
    fi
  fi
  local status=0
  case "$agents" in yes) agents=--with-agents ;; no) agents=--no-extras ;; esac
  offer_agents "$agents" "$root/agents" "$claude_dir/agents" "${XDG_STATE_HOME:-$HOME/.local/state}/loopherd/agents.sha256"
  # The plugin goes into the config dir beside --settings, like the hooks and agents (D27).
  # A failed install is reported, but the herdr offers still run before it fails the run.
  if [[ -n "$settings" ]]; then
    CLAUDE_CONFIG_DIR=$claude_dir offer_skills "$skills" "$claude_dir" --name-dir || status=1
  else
    offer_skills "$skills" "$claude_dir" || status=1
  fi
  offer_herdr_plugin "$herdr_plugin" "$root/herdr-plugin/herdr-plugin.toml" "$settings"
  offer_herdr_keys "$herdr_keys" "$loopherd" "$settings"
  return "$status"
}

case "${1:-}" in
  splash) play_splash ;;
  offers)
    shift
    (($# == 5 || $# == 6)) || { echo "install-extras: offers takes <agents> <skills> <herdr-plugin> <herdr-keys> <loopherd> [<settings file>]" >&2; exit 2; }
    run_offers "$@"
    ;;
  *)
    echo "usage: install-extras splash | offers <agents> <skills> <herdr-plugin> <herdr-keys> <loopherd> [<settings file>]" >&2
    exit 2
    ;;
esac
