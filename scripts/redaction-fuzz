#!/usr/bin/env bash
# Runs notification redaction (summary() in src/notify.rs) at a base revision and at the
# working tree on the same seeded questions, and fails if the working tree shows any word
# the base hid. Over-redaction passes. A base on a remote (origin/main) is fetched first.
# Hidden means hidden by the base's rules: the base also runs with its line cut lifted, so
# a word its 200-character cut left off doesn't count as hidden.
#
#   scripts/redaction-fuzz [base-ref] [count] [seed]    defaults: origin/main 1000000 1
set -euo pipefail

base=${1:-origin/main}
count=${2:-1000000}
seed=${3:-1}
root=$(git rev-parse --show-toplevel)
remote=${base%%/*}
if [[ $base == */* ]] && git -C "$root" remote | grep -qx "$remote"; then
  git -C "$root" fetch --quiet "$remote"
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

mkdir "$tmp/base"
git -C "$root" archive "$base" | tar -x -C "$tmp/base"
mkdir -p "$tmp/base/src/notify"
cp "$root/src/notify/fuzz.rs" "$tmp/base/src/notify/fuzz.rs"
grep -q '^mod fuzz;' "$tmp/base/src/notify.rs" ||
  printf '\n#[cfg(test)]\nmod fuzz;\n' >>"$tmp/base/src/notify.rs"

cp -r "$tmp/base" "$tmp/uncut"
max_text='const MAX_TEXT: usize = 200;'
grep -qxF "$max_text" "$tmp/uncut/src/notify.rs" || {
  echo "redaction-fuzz: $base's src/notify.rs has no line '$max_text' to lift" >&2
  exit 1
}
sed -i "s/^$max_text\$/const MAX_TEXT: usize = usize::MAX;/" "$tmp/uncut/src/notify.rs"

export LOOPHERD_FUZZ_SEED=$seed LOOPHERD_FUZZ_COUNT=$count
target=${CARGO_TARGET_DIR:-$root/target}
write_summaries() {
  (
    cd "$1"
    LOOPHERD_FUZZ_OUT="$2" CARGO_TARGET_DIR="$target/$3" \
      cargo test --release --quiet --bin loopherd notify::fuzz::write_summaries -- --ignored --exact
  )
}
write_summaries "$tmp/base" "$tmp/base.txt" redaction-fuzz-base
write_summaries "$tmp/uncut" "$tmp/uncut.txt" redaction-fuzz-base-uncut
cd "$root"
LOOPHERD_FUZZ_BASE="$tmp/base.txt" LOOPHERD_FUZZ_BASE_UNCUT="$tmp/uncut.txt" \
  cargo test --release --quiet --bin loopherd notify::fuzz::shows_no_word_the_base_hid -- --ignored --exact --nocapture
