#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/install --update [--settings <file>] [install-hook args...]
       scripts/install [--no-splash]
                       [[--with-agents] [--with-skills] [--with-herdr-plugin]
                        [--with-herdr-keys] [--lead-defaults [<switches>]]
                        [--context [<values>]]
                        [--revive-on-startup [true|false]] | --no-extras]
                       [--settings <file>] [install-hook args...]

Build loopherd, install it as ~/.local/bin/loopherd, and add its Claude
Stop/StopFailure/SessionStart/PreToolUse/UserPromptSubmit hooks and the loopherd skill.
On a terminal it then offers loopherd's agent types (builder, reviewer,
researcher, scout), the mattpocock-skills plugin, loopherd's herdr
plugin and herdr key bindings for that plugin's actions, each default no,
then runs `loopherd setup`, which asks, while
config.toml leaves them unset, which lead switches are on wherever a herd
file's [lead] doesn't set them, the context window and handoff limits, and
whether herdr's startup hook also resumes members (alive leads' brokers
start either way). Last, unless --remove, it runs
`loopherd doctor` (against --settings when given), whose failures don't
fail the install.
Other arguments go to `loopherd install-hook`.

  scripts/install                      hooks in ~/.claude/settings.json, skill in ~/.agents/skills linked from ~/.claude/skills
  scripts/install --settings <file>    hooks in <file>, skill in .agents/skills beside it linked from skills/
  scripts/install --no-splash          skip the opening animation (or set LOOPHERD_NO_SPLASH=1)
  scripts/install --with-agents        also install the agent types, asking nothing else
  scripts/install --with-skills        also install the mattpocock-skills plugin, asking nothing else
  scripts/install --with-herdr-plugin  also install or update loopherd's herdr plugin, asking nothing else
  scripts/install --with-herdr-keys    also bind prefix+m and prefix+shift+m to the plugin's views in herdr's
                                       config.toml, asking nothing else
  scripts/install --lead-defaults      ask about the lead switches again, current values as defaults
  scripts/install --lead-defaults merge,install
                                       turn those lead switches on and the rest off (or: none), asking nothing else
  scripts/install --context            ask about the context window and handoff limits again
  scripts/install --context window=1000000,limit=500000,shepherd=400000
                                       set any of those, in tokens, asking nothing else
  scripts/install --revive-on-startup  ask again whether herdr's startup hook resumes members and prompts leads
  scripts/install --revive-on-startup true
                                       set it (or: false), asking nothing else
  scripts/install --no-extras          install no extras and run no setup, without the questions
  scripts/install --update             reinstall after a git pull: no splash and no fresh-install questions;
                                       refreshes loopherd's agent types only if it installed them, prints the
                                       update command for an installed mattpocock-skills plugin, then runs
                                       plain loopherd setup, which asks only about settings still unset
  scripts/install -h, --help           print this and exit

Values given with --lead-defaults, --context or --revive-on-startup are set right after the
build, before anything is installed, so a bad one installs nothing.
loopherd's herdr plugin is offered only when herdr is on PATH and the
plugin isn't already at this checkout's version, and never with --settings.
The key bindings are offered only once that plugin is installed, never with
--settings, and skip a key or action already bound.
The settings go to config.toml in $LOOPHERD_CONFIG_DIR (default
$XDG_CONFIG_HOME/loopherd or ~/.config/loopherd), whatever --settings names.
USAGE
}

splash=1
agents=ask
skills=ask
herdr_plugin=ask
herdr_keys=ask
setup_args=()
no_extras=
updating=
settings=
removing=
args=()
want_settings=
want_value=
lead_list=
lead_set=
for arg in "$@"; do
  if [[ -n "$want_settings" ]]; then settings=$arg; want_settings=; fi
  if [[ -n "$want_value" ]]; then
    if [[ "$arg" != -* ]]; then
      setup_args[${#setup_args[@]}-1]+="=$arg"
      [[ "$want_value" != --lead-defaults ]] || lead_set=1 lead_list=$arg
      want_value=
      continue
    fi
    want_value=
  fi
  case "$arg" in
    -h | --help) usage; exit 0 ;;
    --no-splash) splash= ;;
    --with-agents) agents=yes ;;
    --with-skills) skills=yes ;;
    --with-herdr-plugin) herdr_plugin=yes ;;
    --with-herdr-keys) herdr_keys=yes ;;
    --no-extras) no_extras=1 ;;
    --update) updating=1 ;;
    --lead-defaults | --context | --revive-on-startup) setup_args+=("$arg") want_value=$arg ;;
    --lead-defaults=*) setup_args+=("$arg") lead_set=1 lead_list=${arg#--lead-defaults=} ;;
    --context=* | --revive-on-startup=*) setup_args+=("$arg") ;;
    --settings) want_settings=1; args+=("$arg") ;;
    --remove) removing=1; args+=("$arg") ;;
    --settings=*) settings=${arg#--settings=}; args+=("$arg") ;;
    *) args+=("$arg") ;;
  esac
done

setup=ask
[[ ${#setup_args[@]} -eq 0 ]] || setup=given
if [[ -n "$updating" ]]; then
  [[ -z "$no_extras$removing" && "$agents$skills$herdr_plugin$herdr_keys$setup" == askaskaskaskask ]] || { echo "install: --update can't go with --no-extras, --remove, --with-agents, --with-skills, --with-herdr-plugin, --with-herdr-keys, --lead-defaults, --context or --revive-on-startup" >&2; exit 2; }
  splash= agents=update skills=update herdr_plugin=no herdr_keys=no
elif [[ -n "$no_extras" ]]; then
  [[ "$agents$skills$herdr_plugin$herdr_keys$setup" == askaskaskaskask ]] || { echo "install: --no-extras can't go with --with-agents, --with-skills, --with-herdr-plugin, --with-herdr-keys, --lead-defaults, --context or --revive-on-startup" >&2; exit 2; }
  agents=no skills=no herdr_plugin=no herdr_keys=no setup=no
elif [[ "$agents$skills$herdr_plugin$herdr_keys$setup" != askaskaskaskask ]]; then
  # Naming one extra means just those, with no questions.
  [[ "$agents" == yes ]] || agents=no
  [[ "$skills" == yes ]] || skills=no
  [[ "$herdr_plugin" == yes ]] || herdr_plugin=no
  [[ "$herdr_keys" == yes ]] || herdr_keys=no
  [[ "$setup" == given ]] || setup=no
fi
[[ -z "$removing" ]] || agents=no skills=no herdr_plugin=no herdr_keys=no setup=no

lead_switches=(merge install rebase new_cards design_escalation blocked_dialogs follow_ups_ready)
trim() { local s=${1#"${1%%[![:space:]]*}"}; echo "${s%"${s##*[![:space:]]}"}"; }
# Checked here too, so a typo fails before anything is built or installed.
if [[ -n "$lead_set" && "$(trim "$lead_list")" != none ]]; then
  # The extra comma keeps a trailing empty name, which read would drop.
  IFS=, read -r -a named <<<"$lead_list,"
  for name in "${named[@]}"; do
    name=$(trim "$name")
    [[ -n "$name" && " ${lead_switches[*]} " == *" $name "* ]] || {
      echo "install: unknown lead switch \"$name\" in --lead-defaults: name some of ${lead_switches[*]}, or none" >&2
      exit 2
    }
  done
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

command -v jq >/dev/null || { echo "install: needs jq (to read cargo's build output); install it first" >&2; exit 1; }

splash_file="$root/scripts/install-splash.bash"
if [[ -n "$splash" && -r "$splash_file" ]] && source "$splash_file" && splash_wants_to_play; then
  splash_play || exit
fi
bin_dir="$HOME/.local/bin"

built=$(cargo build --release --manifest-path "$root/Cargo.toml" \
  --message-format=json-render-diagnostics |
  jq -r 'select(.reason == "compiler-artifact" and .target.name == "loopherd" and .executable != null) | .executable')
[[ -x "$built" ]] || { echo "install: cargo built no loopherd binary" >&2; exit 1; }
# Before installing, so a bad setup value installs nothing.
[[ "$setup" != given ]] || "$built" setup "${setup_args[@]}"

mkdir -p "$bin_dir"
# An unchanged build keeps the installed file, whose dev/ino doctor reads to spot stale brokers.
if ! [[ -x "$bin_dir/loopherd" ]] || ! cmp -s "$built" "$bin_dir/loopherd"; then
  tmp=$(mktemp "$bin_dir/.loopherd.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  cp "$built" "$tmp"
  chmod 755 "$tmp"
  # A rename, so a running loopherd or a hook mid-call never sees a half-copied file.
  mv -f "$tmp" "$bin_dir/loopherd"
  trap - EXIT
fi

# Last install wins, so this replaces a release record; --settings runs (tests) write none.
if [[ -z "$settings" ]]; then
  config=${LOOPHERD_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/loopherd}
  checkout=${root//\\/\\\\}
  mkdir -p "$config"
  {
    printf 'kind = "source"\ncheckout = "%s"\n' "${checkout//\"/\\\"}"
    # The commit installed, so loopherd update can retry an install that failed after its pull.
    ! commit=$(git -C "$root" rev-parse HEAD 2>/dev/null) || printf 'commit = "%s"\n' "$commit"
  } >"$config/install.toml.tmp"
  mv -f "$config/install.toml.tmp" "$config/install.toml"
fi

# The ${..+..} form: bash before 4.4 calls an empty array unbound under set -u.
"$bin_dir/loopherd" install-hook ${args[@]+"${args[@]}"}

"$root/scripts/install-extras" offers "$agents" "$skills" "$herdr_plugin" "$herdr_keys" "$bin_dir/loopherd" "$settings"
[[ "$setup" != ask ]] || "$bin_dir/loopherd" setup || echo "install: setup failed; run loopherd setup once config.toml is fixed" >&2
# herdr may not be started yet, so a doctor failure is shown but doesn't fail the install.
[[ -n "$removing" ]] || "$bin_dir/loopherd" doctor ${settings:+--settings "$settings"} || true
