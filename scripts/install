#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/install [--no-splash] [--settings <file>] [install-hook args...]

Build loopherd, install it as ~/.local/bin/loopherd, and add its Claude
Stop/StopFailure/SessionStart/PreToolUse hooks and the loopherd skill.
Other arguments go to `loopherd install-hook`.

  scripts/install                      hooks in ~/.claude/settings.json, skill in ~/.claude/skills
  scripts/install --settings <file>    hooks in <file>, skill in skills/ beside it
  scripts/install --no-splash          skip the opening animation (or set LOOPHERD_NO_SPLASH=1)
  scripts/install -h, --help           print this and exit
USAGE
}

splash=1
args=()
for arg in "$@"; do
  case "$arg" in
    -h | --help) usage; exit 0 ;;
    --no-splash) splash= ;;
    *) args+=("$arg") ;;
  esac
done

command -v jq >/dev/null || { echo "install: needs jq (to read cargo's build output); install it first" >&2; exit 1; }

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source "$root/scripts/install-splash.bash"
if [[ -n "$splash" ]] && splash_wants_to_play; then splash_play; fi
bin_dir="$HOME/.local/bin"

built=$(cargo build --release --manifest-path "$root/Cargo.toml" \
  --message-format=json-render-diagnostics |
  jq -r 'select(.reason == "compiler-artifact" and .target.name == "loopherd" and .executable != null) | .executable')
[[ -x "$built" ]] || { echo "install: cargo built no loopherd binary" >&2; exit 1; }

mkdir -p "$bin_dir"
tmp=$(mktemp "$bin_dir/.loopherd.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cp "$built" "$tmp"
chmod 755 "$tmp"
# A rename, so a running loopherd or a hook mid-call never sees a half-copied file.
mv -f "$tmp" "$bin_dir/loopherd"
trap - EXIT

# The ${..+..} form: bash before 4.4 calls an empty array unbound under set -u.
"$bin_dir/loopherd" install-hook ${args[@]+"${args[@]}"}
