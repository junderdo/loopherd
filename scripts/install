#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/install [--no-splash] [[--with-agents] [--with-skills] | --no-extras]
                       [--settings <file>] [install-hook args...]

Build loopherd, install it as ~/.local/bin/loopherd, and add its Claude
Stop/StopFailure/SessionStart/PreToolUse hooks and the loopherd skill.
On a terminal it then offers loopherd's agent types (builder, reviewer,
researcher, scout) and the mattpocock-skills plugin, each default no. Other
arguments go to `loopherd install-hook`.

  scripts/install                      hooks in ~/.claude/settings.json, skill in ~/.claude/skills
  scripts/install --settings <file>    hooks in <file>, skill in skills/ beside it
  scripts/install --no-splash          skip the opening animation (or set LOOPHERD_NO_SPLASH=1)
  scripts/install --with-agents        also install the agent types, asking nothing else
  scripts/install --with-skills        also install the mattpocock-skills plugin, asking nothing else
  scripts/install --no-extras          install neither, without the questions
  scripts/install -h, --help           print this and exit
USAGE
}

splash=1
agents=ask
skills=ask
no_extras=
settings=
removing=
args=()
want_settings=
for arg in "$@"; do
  if [[ -n "$want_settings" ]]; then settings=$arg; want_settings=; fi
  case "$arg" in
    -h | --help) usage; exit 0 ;;
    --no-splash) splash= ;;
    --with-agents) agents=yes ;;
    --with-skills) skills=yes ;;
    --no-extras) no_extras=1 ;;
    --settings) want_settings=1; args+=("$arg") ;;
    --remove) removing=1; args+=("$arg") ;;
    --settings=*) settings=${arg#--settings=}; args+=("$arg") ;;
    *) args+=("$arg") ;;
  esac
done

if [[ -n "$no_extras" ]]; then
  [[ "$agents$skills" == askask ]] || { echo "install: --no-extras can't go with --with-agents or --with-skills" >&2; exit 2; }
  agents=no skills=no
elif [[ "$agents$skills" != askask ]]; then
  # Naming one extra means just those, with no questions.
  [[ "$agents" == yes ]] || agents=no
  [[ "$skills" == yes ]] || skills=no
fi
[[ -z "$removing" ]] || agents=no skills=no

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=install-agents.bash
source "$root/scripts/install-agents.bash"
# shellcheck source=install-skills.bash
source "$root/scripts/install-skills.bash"

command -v jq >/dev/null || { echo "install: needs jq (to read cargo's build output); install it first" >&2; exit 1; }

splash_file="$root/scripts/install-splash.bash"
if [[ -n "$splash" && -r "$splash_file" ]] && source "$splash_file" && splash_wants_to_play; then
  splash_play || exit
fi
bin_dir="$HOME/.local/bin"

built=$(cargo build --release --manifest-path "$root/Cargo.toml" \
  --message-format=json-render-diagnostics |
  jq -r 'select(.reason == "compiler-artifact" and .target.name == "loopherd" and .executable != null) | .executable')
[[ -x "$built" ]] || { echo "install: cargo built no loopherd binary" >&2; exit 1; }

mkdir -p "$bin_dir"
tmp=$(mktemp "$bin_dir/.loopherd.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cp "$built" "$tmp"
chmod 755 "$tmp"
# A rename, so a running loopherd or a hook mid-call never sees a half-copied file.
mv -f "$tmp" "$bin_dir/loopherd"
trap - EXIT

# The ${..+..} form: bash before 4.4 calls an empty array unbound under set -u.
"$bin_dir/loopherd" install-hook ${args[@]+"${args[@]}"}

claude_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
if [[ -n "$settings" ]]; then
  claude_dir=$(dirname "$settings")
  # Absolute, so CLAUDE_CONFIG_DIR and what the installer prints don't hang on cwd.
  if [[ -d "$claude_dir" ]]; then
    claude_dir=$(cd "$claude_dir" && pwd)
  elif [[ "$claude_dir" != /* ]]; then
    claude_dir="$PWD/${claude_dir#./}"
  fi
fi
case "$agents" in yes) agents=--with-agents ;; no) agents=--no-extras ;; esac
offer_agents "$agents" "$root/agents" "$claude_dir/agents" "${XDG_STATE_HOME:-$HOME/.local/state}/loopherd/agents.sha256"
# The plugin goes into the config dir beside --settings, like the hooks and agents (D27).
if [[ -n "$settings" ]]; then
  CLAUDE_CONFIG_DIR=$claude_dir offer_skills "$skills" "$claude_dir" --name-dir
else
  offer_skills "$skills" "$claude_dir"
fi
