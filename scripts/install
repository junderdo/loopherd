#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/install [--no-splash]
                       [[--with-agents] [--with-skills] [--lead-defaults [<switches>]] | --no-extras]
                       [--settings <file>] [install-hook args...]

Build loopherd, install it as ~/.local/bin/loopherd, and add its Claude
Stop/StopFailure/SessionStart/PreToolUse hooks and the loopherd skill.
On a terminal it then offers loopherd's agent types (builder, reviewer,
researcher, scout) and the mattpocock-skills plugin, each default no, and,
until config.toml has a [lead_defaults], asks which lead switches are on
wherever a herd file's [lead] doesn't set them. Other arguments go to
`loopherd install-hook`.

  scripts/install                      hooks in ~/.claude/settings.json, skill in ~/.claude/skills
  scripts/install --settings <file>    hooks in <file>, skill in skills/ beside it
  scripts/install --no-splash          skip the opening animation (or set LOOPHERD_NO_SPLASH=1)
  scripts/install --with-agents        also install the agent types, asking nothing else
  scripts/install --with-skills        also install the mattpocock-skills plugin, asking nothing else
  scripts/install --lead-defaults      ask about the lead switches again, current values as defaults
  scripts/install --lead-defaults merge,install
                                       turn those lead switches on and the rest off (or: none), asking nothing else
  scripts/install --no-extras          install no extras and leave the lead defaults, without the questions
  scripts/install -h, --help           print this and exit

The lead defaults go to config.toml in $LOOPHERD_CONFIG_DIR (default
$XDG_CONFIG_HOME/loopherd or ~/.config/loopherd), whatever --settings names.
USAGE
}

splash=1
agents=ask
skills=ask
lead_defaults=ask
lead_list=
no_extras=
settings=
removing=
args=()
want_settings=
want_lead_list=
for arg in "$@"; do
  if [[ -n "$want_settings" ]]; then settings=$arg; want_settings=; fi
  if [[ -n "$want_lead_list" ]]; then
    want_lead_list=
    [[ "$arg" == -* ]] || { lead_defaults=set lead_list=$arg; continue; }
  fi
  case "$arg" in
    -h | --help) usage; exit 0 ;;
    --no-splash) splash= ;;
    --with-agents) agents=yes ;;
    --with-skills) skills=yes ;;
    --no-extras) no_extras=1 ;;
    --lead-defaults) lead_defaults=reask want_lead_list=1 ;;
    --lead-defaults=*) lead_defaults=set lead_list=${arg#--lead-defaults=} ;;
    --settings) want_settings=1; args+=("$arg") ;;
    --remove) removing=1; args+=("$arg") ;;
    --settings=*) settings=${arg#--settings=}; args+=("$arg") ;;
    *) args+=("$arg") ;;
  esac
done

if [[ -n "$no_extras" ]]; then
  [[ "$agents$skills$lead_defaults" == askaskask ]] || { echo "install: --no-extras can't go with --with-agents, --with-skills or --lead-defaults" >&2; exit 2; }
  agents=no skills=no lead_defaults=no
elif [[ "$agents$skills$lead_defaults" != askaskask ]]; then
  # Naming one extra means just those, with no questions.
  [[ "$agents" == yes ]] || agents=no
  [[ "$skills" == yes ]] || skills=no
  [[ "$lead_defaults" != ask ]] || lead_defaults=no
fi
[[ -z "$removing" ]] || agents=no skills=no lead_defaults=no

lead_switches=(merge install rebase new_cards design_escalation blocked_dialogs)
lead_switch_help=(
  "merge a PR its reviewer verified"
  "run scripts/install and loopherd install-hook"
  "have a member rebase and force-push"
  "create cards for out-of-scope gaps"
  "settle a design question a member raises"
  "answer a member's blocking dialog"
)

trim() { local s=${1#"${1%%[![:space:]]*}"}; echo "${s%"${s##*[![:space:]]}"}"; }
if [[ "$lead_defaults" == set && "$(trim "$lead_list")" != none ]]; then
  # The extra comma keeps a trailing empty name, which read would drop.
  IFS=, read -r -a named <<<"$lead_list,"
  for name in "${named[@]}"; do
    name=$(trim "$name")
    [[ -n "$name" && " ${lead_switches[*]} " == *" $name "* ]] || {
      echo "install: unknown lead switch \"$name\" in --lead-defaults: name some of ${lead_switches[*]}, or none" >&2
      exit 2
    }
  done
fi

# Usage: offer_lead_defaults <ask|reask|no|set> <loopherd> [<switches>]
# ask: only while config.toml has no [lead_defaults]; reask: always.
offer_lead_defaults() {
  local want=$1 loopherd=$2 list=${3-} current answer default i on=()
  case "$want" in
    no) return 0 ;;
    ask | reask) ;;
    set)
      "$loopherd" lead-defaults --set "$list" >/dev/null
      echo "set the lead defaults: $list"
      return 0
      ;;
  esac
  current=$("$loopherd" lead-defaults) || {
    if [[ "$want" == reask ]]; then
      echo "install: loopherd couldn't read the lead defaults" >&2
      exit 1
    fi
    echo "skipped the lead defaults: loopherd couldn't read them" >&2
    return 0
  }
  [[ "$want" == reask || -z "$current" ]] || return 0
  if [[ ! -t 0 ]]; then
    echo "skipped the lead defaults (no terminal); add --lead-defaults <switches|none> to set them"
    return 0
  fi
  echo "Lead defaults: what a herd's lead may do on its own wherever its herd file's [lead] doesn't say. Off means the human does it."
  for i in "${!lead_switches[@]}"; do
    default=n
    grep -qx "${lead_switches[i]} on" <<<"$current" && default=y
    if [[ "$default" == y ]]; then
      read -r -p "  ${lead_switches[i]}: ${lead_switch_help[i]}? [Y/n] " answer || answer=
    else
      read -r -p "  ${lead_switches[i]}: ${lead_switch_help[i]}? [y/N] " answer || answer=
    fi
    case "$answer" in
      [yY]*) on+=("${lead_switches[i]}") ;;
      [nN]*) ;;
      *) [[ "$default" == n ]] || on+=("${lead_switches[i]}") ;;
    esac
  done
  list=$(IFS=,; echo "${on[*]+${on[*]}}")
  "$loopherd" lead-defaults --set "${list:-none}" >/dev/null
  echo "set the lead defaults: ${list:-none}"
}

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=install-agents.bash
source "$root/scripts/install-agents.bash"
# shellcheck source=install-skills.bash
source "$root/scripts/install-skills.bash"

command -v jq >/dev/null || { echo "install: needs jq (to read cargo's build output); install it first" >&2; exit 1; }

splash_file="$root/scripts/install-splash.bash"
if [[ -n "$splash" && -r "$splash_file" ]] && source "$splash_file" && splash_wants_to_play; then
  splash_play || exit
fi
bin_dir="$HOME/.local/bin"

built=$(cargo build --release --manifest-path "$root/Cargo.toml" \
  --message-format=json-render-diagnostics |
  jq -r 'select(.reason == "compiler-artifact" and .target.name == "loopherd" and .executable != null) | .executable')
[[ -x "$built" ]] || { echo "install: cargo built no loopherd binary" >&2; exit 1; }

mkdir -p "$bin_dir"
tmp=$(mktemp "$bin_dir/.loopherd.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cp "$built" "$tmp"
chmod 755 "$tmp"
# A rename, so a running loopherd or a hook mid-call never sees a half-copied file.
mv -f "$tmp" "$bin_dir/loopherd"
trap - EXIT

# The ${..+..} form: bash before 4.4 calls an empty array unbound under set -u.
"$bin_dir/loopherd" install-hook ${args[@]+"${args[@]}"}

claude_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
if [[ -n "$settings" ]]; then
  claude_dir=$(dirname "$settings")
  # Absolute, so CLAUDE_CONFIG_DIR and what the installer prints don't hang on cwd.
  if [[ -d "$claude_dir" ]]; then
    claude_dir=$(cd "$claude_dir" && pwd)
  elif [[ "$claude_dir" != /* ]]; then
    claude_dir="$PWD/${claude_dir#./}"
  fi
fi
case "$agents" in yes) agents=--with-agents ;; no) agents=--no-extras ;; esac
offer_agents "$agents" "$root/agents" "$claude_dir/agents" "${XDG_STATE_HOME:-$HOME/.local/state}/loopherd/agents.sha256"
# The plugin goes into the config dir beside --settings, like the hooks and agents (D27).
if [[ -n "$settings" ]]; then
  CLAUDE_CONFIG_DIR=$claude_dir offer_skills "$skills" "$claude_dir" --name-dir
else
  offer_skills "$skills" "$claude_dir"
fi
offer_lead_defaults "$lead_defaults" "$bin_dir/loopherd" "$lead_list"
